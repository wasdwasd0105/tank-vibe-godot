; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Battle Tank"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Battle City"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Events="*res://scripts/autoload/events.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
ThemeManager="*res://scripts/autoload/theme_manager.gd"
InputSettings="*res://scripts/autoload/input_settings.gd"
WindowManager="*res://scripts/autoload/window_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SoundManager="*res://scripts/autoload/sound_manager.gd"
Localization="*res://scripts/autoload/localization.gd"
PlayerInput="*res://scripts/autoload/player_input.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1600
window/size/window_height_override=1000
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Battle City"

